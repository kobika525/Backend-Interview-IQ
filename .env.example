APP_NAME=Interview IQ
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api
SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/interview_iq
TEST_DATABASE_URL=mysql+pymysql://root:password@localhost:3306/interview_iq_test
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
MAX_RESUME_SIZE_MB=10
MAX_AUDIO_SIZE_MB=50
MAX_VIDEO_SIZE_MB=250
AI_MODE=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120
WHISPER_MODEL=base
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm
FFMPEG_PATH=ffmpeg
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@interviewiq.local
RATE_LIMIT_ENABLED=false
LOG_LEVEL=INFO
ADMIN_EMAIL=admin@interviewiq.com
ADMIN_PASSWORD=
